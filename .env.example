# Copy this file to .env and fill in real values for your environment.
# .env is gitignored — never commit real credentials.

# local | production  (controls error display + secure-cookie defaults,
# and — combined with APP_FORCE_HTTPS — whether HTTP requests get redirected)
APP_ENV=local

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=food-ordering-system

# Set to "true" only once the site is served over HTTPS.
APP_FORCE_SECURE_COOKIES=false

# The public base URL of this site, no trailing slash. Used to build links
# in emails and Stripe redirect URLs. For local testing with `php -S`:
APP_BASE_URL=http://localhost:8000

# Set to "true" once you have a real domain + TLS certificate — this makes
# every plain HTTP request redirect to HTTPS. Leave "false" for local dev
# (php -S doesn't speak HTTPS, so turning this on locally would break
# every page load).
APP_FORCE_HTTPS=false

# --- Outgoing email (SMTP) ---
# Leave SMTP_HOST blank to disable real email sending — the app falls back
# to PHP's mail() function (which usually does nothing on local dev) and
# logs what would have been sent. Any SMTP provider works: Gmail (with an
# app password), SendGrid, Mailtrap (great for local testing — captures
# mail without actually delivering it), your own mail server, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=Food Ordering System

# --- Stripe (card payments) ---
# Leave blank to disable card payments — "Cash on Delivery" still works
# with no configuration. Get free test-mode keys from your Stripe
# dashboard (no real business or bank account needed for test mode):
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the Stripe CLI or your webhook endpoint settings — needed to verify
# that webhook requests really came from Stripe:
STRIPE_WEBHOOK_SECRET=
