# Copy this file to .env and fill in real values for your environment.
# .env is gitignored — never commit real credentials.

# local | production  (controls error display + secure-cookie defaults)
APP_ENV=local

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=food-ordering-system

# Set to "true" only once the site is served over HTTPS.
APP_FORCE_SECURE_COOKIES=false
